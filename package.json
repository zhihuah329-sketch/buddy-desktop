{
  "name": "buddy-desktop",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "A standalone Windows desktop app for WorkBuddy multi-account pools: quota-aware rotation, OpenAI-compatible forwarding, and a Command Code channel.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhihuah329-sketch/buddy-desktop.git"
  },
  "keywords": [
    "workbuddy",
    "account-pool",
    "quota-rotation",
    "openai-compatible",
    "electron",
    "svelte"
  ],
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "node packages/server/src/cli.js",
    "dev": "node packages/server/src/cli.js",
    "ui": "node packages/ui/node_modules/vite/bin/vite.js build",
    "exe": "node tools/build-exe.mjs",
    "installer": "node tools/build-installer.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "postject": "1.0.0-alpha.6"
  }
}
